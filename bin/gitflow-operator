#!/usr/bin/env python3
"""Compatibility launcher for the independently maintained Gitflow Operator."""

import json
import os
from pathlib import Path
import sys


def main() -> int:
    current = Path(__file__).resolve()
    override = os.environ.get("GITFLOW_OPERATOR_EXECUTABLE")
    candidates = [override] if override else os.environ.get("PATH", "").split(os.pathsep)
    if not override:
        candidates = [str(Path(entry or ".") / "gitflow-operator") for entry in candidates]

    for candidate in candidates:
        if not candidate:
            continue
        path = Path(candidate).expanduser()
        try:
            resolved = path.resolve(strict=True)
        except OSError:
            continue
        if resolved == current or not os.access(resolved, os.X_OK):
            continue
        os.execv(str(resolved), [str(resolved), *sys.argv[1:]])

    print(json.dumps({
        "operation": "dispatch",
        "status": "blocked",
        "outcome": "blocked",
        "reason": "standalone gitflow-operator installation not found",
    }, sort_keys=True))
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
